# Copy this file to .env and fill in for production.
# In development, leaving FRONTEND_URL unset defaults to http://localhost:5173

PORT=4000
FRONTEND_URL=https://your-deployed-frontend.example.com

# Required — from Vercel Postgres (Storage tab in your Vercel project) or Neon directly.
# Vercel auto-injects this when you connect a Postgres database to your project,
# so on Vercel itself you usually don't set this by hand.
POSTGRES_URL=

# Added in Step 7 (Groq AI integration) — do not commit your real key
GROQ_API_KEY=
